{
  "name": "gym-entry-mern",
  "version": "1.0.0",
  "description": "MERN Stack Gym Entry Application",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:frontend:live": "cd frontend && npm run dev:live",
    "dev:frontend:local": "cd frontend && npm run dev:local",
    "dev:frontend:prod": "cd frontend && npm run dev:prod",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "chrome": "open -a \"Google Chrome\" --args --new-window http://localhost:5173",
    "dev:chrome": "concurrently \"npm run dev\" \"sleep 3 && npm run chrome\"",
    "cap:sync": "cd frontend && npm run cap:sync",
    "cap:sync:ios:store": "cd frontend && npm run cap:sync:ios:store",
    "cap:sync:live": "cd frontend && npm run cap:sync:live",
    "cap:open:ios": "cd frontend && npm run cap:open:ios",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "type": "module",
  "keywords": [
    "mern",
    "gym",
    "fitness",
    "react",
    "node",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "axios": "^1.7.8",
    "axis": "^1.0.0",
    "base64-arraybuffer": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "firebase-admin": "^13.8.0",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1"
  }
}
